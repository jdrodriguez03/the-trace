# Copia a .env cuando empieces el backend (fases posteriores del pipeline).
# La app lee estas dos en el navegador. gemini-3.8-flash se satura; 3.5 Flash Lite es el predeterminado.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
# SENTRY_DSN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RENDER_* — se configuran en el dashboard de Render, no en el frontend.
