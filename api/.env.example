# Copia este archivo:  cp api/.env.example api/.env
# Los valores reales los comparte Julian por el chat privado. Este archivo sí se sube; api/.env nunca.

# Supabase → Connect → "Session pooler". Cambia el inicio por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co

GEMINI_API_KEY=xxxx
GEMINI_MODEL=gemini-3.5-flash-lite

# Precios: Yahoo Finance no pide clave. Cada cuántos minutos se piden precios nuevos.
PRICE_REFRESH_MINUTES=15
# "yahoo" pide precios nuevos en horario de mercado; "off" nunca los pide (útil si Yahoo falla).
PRICE_PROVIDER=yahoo

WEB_ORIGIN=http://localhost:5173
SENTRY_DSN=
